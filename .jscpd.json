{
  "minTokens": 50,
  "threshold": 0,
  "absolute": false,
  "gitignore": true,
  "ignore": [
    "**/dist/**",
    "**/vendor/**",
    "**/node_modules/**",
    "**/tests/**",
    "**/test/**",
    "**/.git/**",
    "**/*.min.js",
    "**/frontend/cards/**",
    "**/translations/**",
    "scripts/screenshot-forms.json"
  ],
  "reporters": [
    "console",
    "json"
  ],
  "output": "report"
}
