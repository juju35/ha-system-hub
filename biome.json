{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": ["**/*.js", "**/*.mjs", "!**/dist", "!**/vendor", "!**/node_modules", "!**/*.min.js", "!custom_components/system_hub/frontend/system-hub-panel.js", "!custom_components/system_hub/frontend/cards"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": { "noInnerDeclarations": "off" },
      "suspicious": { "noAssignInExpressions": "off" },
      "performance": { "noDynamicNamespaceImportAccess": "off" }
    }
  },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "javascript": { "globals": ["customElements", "HTMLElement", "hass"] }
}
