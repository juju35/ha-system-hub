{
  "entity": {
    "button": {
      "watchdog_check": {
        "default": "mdi:shield-search"
      },
      "marketplace_check_updates": {
        "default": "mdi:archive-refresh"
      },
      "batteries_notify_now": {
        "default": "mdi:bell-ring-outline"
      },
      "git_sync_commit_push": {
        "default": "mdi:source-commit-end"
      },
      "git_sync_export_dashboards": {
        "default": "mdi:export"
      }
    },
    "sensor": {
      "containers_running": {
        "default": "mdi:docker"
      },
      "containers_down": {
        "default": "mdi:package-variant-closed-remove"
      },
      "containers_last_update": {
        "default": "mdi:clock-check-outline"
      },
      "watchdog_unavailable": {
        "default": "mdi:puzzle-remove-outline"
      },
      "watchdog_last_reload": {
        "default": "mdi:restart"
      },
      "watchdog_last_check": {
        "default": "mdi:clock-check-outline"
      },
      "watchdog_reloads_24h": {
        "default": "mdi:counter"
      },
      "marketplace_status": {
        "default": "mdi:archive-check",
        "state": {
          "running": "mdi:archive-sync",
          "error": "mdi:archive-alert"
        }
      },
      "marketplace_last_check": {
        "default": "mdi:clock-check-outline"
      },
      "batteries_low_batteries": {
        "default": "mdi:battery-alert-variant-outline",
        "state": {
          "0": "mdi:battery-check-outline"
        }
      },
      "batteries_last_notification": {
        "default": "mdi:bell-check-outline"
      },
      "batteries_spare_batteries": {
        "default": "mdi:cart-outline",
        "state": {
          "0": "mdi:battery-plus-outline"
        }
      },
      "batteries_next_replacement": {
        "default": "mdi:calendar-clock"
      },
      "git_sync_status": {
        "default": "mdi:git",
        "state": {
          "clean": "mdi:check-circle-outline",
          "dirty": "mdi:file-document-edit-outline",
          "ahead": "mdi:cloud-upload-outline",
          "error": "mdi:alert-circle-outline"
        }
      },
      "git_sync_changed_files": {
        "default": "mdi:file-multiple-outline"
      },
      "git_sync_last_commit": {
        "default": "mdi:source-commit"
      },
      "git_sync_last_push": {
        "default": "mdi:cloud-check-outline"
      },
      "git_sync_last_export": {
        "default": "mdi:view-dashboard-outline"
      },
      "git_sync_branch": {
        "default": "mdi:source-branch"
      }
    }
  },
  "services": {
    "containers_refresh": {
      "service": "mdi:refresh"
    },
    "watchdog_check": {
      "service": "mdi:shield-search"
    },
    "watchdog_reset": {
      "service": "mdi:restart"
    },
    "marketplace_check_updates": {
      "service": "mdi:archive-refresh"
    },
    "marketplace_check_repository": {
      "service": "mdi:archive-refresh-outline"
    },
    "marketplace_install_updates": {
      "service": "mdi:package-down"
    },
    "batteries_notify": {
      "service": "mdi:bell-ring-outline"
    },
    "batteries_set_stock": {
      "service": "mdi:battery-plus-outline"
    },
    "batteries_export": {
      "service": "mdi:file-delimited-outline"
    },
    "git_sync_commit_push": {
      "service": "mdi:source-commit-end"
    },
    "git_sync_export_dashboards": {
      "service": "mdi:export"
    },
    "git_sync_generate_ssh_key": {
      "service": "mdi:key-plus"
    },
    "git_sync_generate_message": {
      "service": "mdi:creation-outline"
    },
    "git_sync_pull": {
      "service": "mdi:source-pull"
    },
    "git_sync_get_diff": {
      "service": "mdi:file-compare"
    }
  }
}
